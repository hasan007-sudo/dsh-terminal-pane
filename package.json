{
  "name": "dsh-terminal-pane",
  "version": "0.1.0",
  "description": "Inline terminal panel docked under the DeepSeek Harness web composer, backed by a real PTY on the host",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "terminal",
    "pty",
    "web-ui",
    "cordis"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1 <0.2.0"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasan007-sudo/dsh-terminal-pane.git"
  },
  "homepage": "https://github.com/hasan007-sudo/dsh-terminal-pane#readme",
  "bugs": {
    "url": "https://github.com/hasan007-sudo/dsh-terminal-pane/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "node-pty": "^1.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.1 <0.2.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
